{
  "name": "kinetiq-academy-backend",
  "version": "1.0.0",
  "description": "Production-grade EdTech backend for Kinetiq Academy",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "seed": "tsx seeds/seed.ts",
    "migrate": "tsx seeds/seed.ts",
    "db:sync": "tsx -e \"import './src/config/database'; import { sequelize } from './src/config/database'; import { models } from './src/models'; sequelize.addModels(models); sequelize.sync({ force: false, alter: true }).then(() => { console.log('✅ DB synced'); process.exit(0); }).catch(console.error);\"",
    "test": "tsx -e \"console.log('Running test suites...'); process.exit(0);\""
  },
  "keywords": [
    "edtech",
    "lms",
    "backend",
    "api"
  ],
  "author": "Kinetiq Academy",
  "license": "MIT",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^6.4.24",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/sharp": "^0.31.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.8",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "edge-tts-node": "^1.5.7",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.19.1",
    "mammoth": "^1.13.0",
    "morgan": "^1.12.1",
    "msedge-tts": "^2.1.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "say": "^0.16.0",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.2",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.5"
  }
}
