# ==============================================================================
# KINETIQ ACADEMY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

NODE_ENV=development
PORT=4000
API_VERSION=v1

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:5515%40@localhost:5432/kinetiq_academy
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kinetiq_academy
DB_USER=postgres
DB_PASSWORD=5515@
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE=10000

# ─── Redis (Cache & Queue) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS & Frontend ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ─── S3 / MinIO Object Storage ───────────────────────────────────────────────
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_MEDIA=kinetiq-media
S3_BUCKET_AVATARS=kinetiq-avatars
S3_BUCKET_DOCS=kinetiq-docs
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ─── LiveKit WebRTC (Video Classroom) ─────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=EHcfb286f3bbbe568e
LIVEKIT_API_SECRET=d680af564bdf2728f96482e6958fdcf9dc6c60ef03995e48477f18f5ee5ea18c

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@kinetiqacademy.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Kinetiq Academy <noreply@kinetiqacademy.com>"

# ─── Stripe Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_dev
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_for_dev

# ─── AI / OpenAI & Learning Engine ───────────────────────────────────────────
OPENAI_API_KEY=sk-placeholder-openai-api-key
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CHAT_MODEL=gpt-4o-mini
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=onyx

# ─── Video Pipeline & Rendering ───────────────────────────────────────────────
VIDEO_STORAGE_DIR=public/uploads/videos
VIDEO_PROVIDER=scene_renderer
FFMPEG_PATH=
MAX_VIDEO_DURATION_SECONDS=300
VIDEO_RESOLUTION=1920x1080

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=30

# ─── App Info ────────────────────────────────────────────────────────────────
APP_NAME=Kinetiq Academy
APP_URL=http://localhost:4000
BCRYPT_ROUNDS=12
SESSION_SECRET=kinetiq_session_secret_change_in_production
